# ==================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================
# 
# Instructions:
# 1. For DEVELOPMENT: Copy this to .env.local
# 2. For PRODUCTION: Copy this to .env.production
# 3. Fill in your actual values

# Server Configuration
PORT=8080
NODE_ENV=development

# Database
# Development: mongodb://localhost:27017/taskstars
# Production: mongodb+srv://username:password@cluster.mongodb.net/taskstars
MONGO_URI=mongodb://localhost:27017/taskstars

# JWT Secret (use a strong random string in production)
JWT_SECRET=your-jwt-secret-key-here

# OAuth - Google (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - GitHub (Get from GitHub Developer Settings)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# URLs
# Development:
#   CLIENT_URL=http://localhost:3000
#   SERVER_URL=http://localhost:8080
# Production:
#   CLIENT_URL=https://taskstars.onrender.com
#   SERVER_URL=https://taskstars.onrender.com
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080

# OpenAI API Key (optional)
OPENAI_API_KEY=your-openai-api-key

